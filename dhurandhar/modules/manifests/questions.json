    "question_bank": {
      "class_path": "dhurandhar.tools.builtin:QuestionBankTool",
      "order": 21
    }
  },
  "routes": [
    {
      "reference": "dhurandhar.api.routers.question:router",
      "options": {
        "prefix": "/api/question",
        "tags": [
          "question"
        ]
      },
      "auth": "learning",
      "order": 572
    },
    {
      "reference": "dhurandhar.api.routers.question:ws_router",
      "options": {
        "prefix": "/ws/questions",
        "tags": [
          "question"
        ]
      },
      "auth": "public",
      "order": 617
    },
    {
      "reference": "dhurandhar.api.routers.question_notebook:router",
      "options": {
        "prefix": "/api/question-notebook",
        "tags": [
          "question-notebook"
        ]
      },
      "auth": "learning",
      "order": 689
    },
    {
      "reference": "dhurandhar.api.routers.practice:router",
      "options": {
        "prefix": "/api/question-notebook/practice",
        "tags": [
          "practice"
        ]
      },
      "auth": "learning",
      "order": 695
    }
