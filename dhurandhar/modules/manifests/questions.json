      "manifest": {
        "name": "deep_question",
        "description": "Fast question generation (Template batches -> Generate).",
        "stages": [
          "ideation",
          "generation"
        ],
        "tools_used": [
          "rag",
          "web_search",
          "exec"
        ],
        "cli_aliases": [
          "quiz"
        ]
      },
      "order": 3
    }
  },
  "loops": {},
